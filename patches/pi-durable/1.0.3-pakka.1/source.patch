+/** Commit a policy rejection without fabricating a provider response or faulting the task. */
+async function blockRequest(runtime: Runtime, reason: string, context: Context): Promise<void> {
+	await runtime.commit(async (tx): Promise<Next> => {
+		const live = await tx.doc(LiveDoc, runtime.conversationId);
+		endRun(tx, live, runtime.taskId, { status: "unanswered", reason: "blocked", detail: reason });
+		return { status: "terminal", outcome: { status: "completed", result: { blocked: reason } } };
+	}, context);
+}
