+				const sequence = await readSchema(transaction, schema, false);
+				context.abortSignal?.throwIfAborted();
+				const queries = new SqliteReadQueries(transaction, schema);
+				let active = true;
+				const run = async <R>(readContext: Context, operation: () => Promise<R>): Promise<R> => {
+					const check = () => {
