+
+export type EntryArchiveChunk = {
+	readonly bytes: Uint8Array;
+	readonly offset: number;
+	readonly nextOffset: number;
+	readonly byteLength: number;
+	readonly commitSeq: Seq;
+};
+
+/**
+ * Optional byte-level archival reads. They obey the same fork visibility as entry()/scanEntries(), but
+ * expose encoded JSON ranges without decoding its model or data. These are trusted storage APIs, not ACLs.
+ * Returned JS ranges are at most 64 KiB. SQLite may retain an encoding-only LRU window of at most 32 MiB,
+ * with serialized acquisition of one additional row at a time, plus bounded immutable header caches.
+ * It never decodes a complete JSON record for these APIs. A record larger than the window stays a range read;
+ * backend-native transient work can still depend on that one record's size. This is not a cumulative history limit.
+ */
+export interface EntryArchive {
+	header(conversationId: ConversationId, id: EntryId, context: Context): Promise<EntryHeader | undefined>;
+	scan(query: EntryQuery, limit: number, cursor: Cursor | undefined, context: Context): Promise<Page<EntryHeader, Cursor>>;
+	read(conversationId: ConversationId, id: EntryId, range: EntryArchiveRange, context: Context): Promise<EntryArchiveChunk | undefined>;
+}
+
 export interface Storage {
+	/** Available only on backends that support bounded encoded entry reads. */
+	readonly entryArchive?: EntryArchive;
 	/**
 	 * Atomically persist one batch and return its sequence. Once resolved, later reads through this storage observe it.
 	 */
