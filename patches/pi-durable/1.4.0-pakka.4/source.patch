--- /dev/null
+++ b/packages/durable/src/storage/sqlite/read-queries.ts
@@ -0,0 +1,435 @@
+import type { Context } from "@earendil-works/chord";
+import { apply, type Op } from "@earendil-works/chord/delta";
+import type { SqliteQueryExecutor, SqliteValue } from "#chord-sqlite/database";
+import { StorageRequestError } from "../../errors.ts";
+import { idFromNumber, seqFromNumber } from "../../ids.ts";
+import type {
+	ConversationId,
+	ConversationQuery,
+	ConversationRecord,
+	Cursor,
+	DocumentAddress,
+	DocumentContent,
+	DocumentCreate,
+	DocumentId,
+	DocumentPoint,
+	DocumentRecord,
+	EntryArchive,
+	EntryArchiveRange,
+	EntryHeader,
+	EntryId,
+	EntryQuery,
+	Id,
+	JsonObject,
+	Page,
+	ScanOrder,
+	Seq,
+	StoredDocument,
+} from "../../types.ts";
+import { nextCursor, type ScanStart, scanStart } from "../scan.ts";
+import type { SqliteSchema } from "./schema.ts";
+
+type JsonRow = { readonly record: string };
+type RevisionRow = {
+	readonly seq: number;
+	readonly kind: DocumentContent["kind"];
+	readonly version: number;
+	readonly content: string;
+};
+type ScopeColumns = {
+	readonly scopeKind: DocumentRecord["scope"]["kind"];
+	readonly ownerId: number;
+};
+
+const parseJson = <T>(value: string): T => JSON.parse(value) as T;
+// Indexed text keeps lone surrogates lossless across SQLite drivers.
+export const encodeIndexedString = (value: string): string => JSON.stringify(value);
+const ARCHIVE_HEADER_CACHE_LIMIT = 2048;
+const ARCHIVE_BYTE_CACHE_LIMIT = 32 * 1024 * 1024;
+export const page = <T extends { readonly id: Id<string> }>(
+	values: readonly T[],
+	limit: number,
+	order: ScanOrder = "ascending",
+): Page<T, Cursor> => {
+	const items = values.slice(0, limit);
+	if (values.length <= limit) return { items };
+	return { items, next: nextCursor(items.at(-1)!.id, order) };
+};
+
+/** The ID condition, its parameter, and the `ORDER BY` direction of a table scan. */
+export const scanSql = (
+	start: ScanStart,
+): { readonly clause: string; readonly param: number; readonly direction: string } =>
+	start.order === "ascending"
+		? { clause: "id > ?", param: start.after ?? -1, direction: "ASC" }
+		: { clause: "id < ?", param: start.after ?? Number.MAX_SAFE_INTEGER, direction: "DESC" };
+
+export const scopeColumns = (scope: DocumentRecord["scope"]): ScopeColumns => {
+	switch (scope.kind) {
+		case "session":
+			return { scopeKind: "session", ownerId: 0 };
+		case "conversation":
+			return { scopeKind: "conversation", ownerId: scope.conversationId };
+		case "task":
+			return { scopeKind: "task", ownerId: scope.taskId };
+	}
+};
+
+export const addressParts = (address: DocumentAddress | DocumentCreate | DocumentRecord) => {
+	const scope = scopeColumns(address.scope);
+	return {
+		kind: encodeIndexedString(address.kind),
+		...scope,
+		family: address.key === undefined ? 0 : 1,
+		keyValue: encodeIndexedString(address.key ?? ""),
+	};
+};
+
+const isAliveAt = (record: DocumentRecord, at: DocumentPoint): boolean => {
+	if (at === "current") return record.retiredAt === undefined;
+	return record.createdAt <= at && (record.retiredAt === undefined || at < record.retiredAt);
+};
+
+export const isCurrentOnly = (record: DocumentRecord): boolean =>
+	record.scope.kind !== "conversation" || record.history === "latest";
+
+/** Shared read queries. The owner supplies a connection or a borrowed consistent read transaction. */
+export class SqliteReadQueries {
+	private readonly db: SqliteQueryExecutor;
+	private readonly schema: SqliteSchema;
+	constructor(db: SqliteQueryExecutor, schema: SqliteSchema) {
+		this.db = db;
+		this.schema = schema;
+	}
+	private readonly archiveHeaders = new Map<EntryId, EntryHeader>();
+	private readonly archiveScopes = new Map<string, EntryHeader>();
+	private readonly archiveBytes = new Map<EntryId, { readonly commitSeq: Seq; readonly bytes: Uint8Array }>();
+	private readonly pendingArchiveBytes = new Map<EntryId, Promise<Uint8Array>>();
+	private archiveByteCount = 0;
+	private archiveByteLine: Promise<void> = Promise.resolve();
+
+	readonly entryArchive: EntryArchive = Object.freeze({
+		header: async (conversationId: ConversationId, id: EntryId, context: Context) => {
+			context.abortSignal?.throwIfAborted();
+			const value = await this.readArchiveHeader(conversationId, id);
+			context.abortSignal?.throwIfAborted();
+			return value;
+		},
+		scan: async (query: EntryQuery, limit: number, cursor: Cursor | undefined, context: Context) => {
+			context.abortSignal?.throwIfAborted();
+			const value = await this.readEntryHeaders(query, limit, cursor);
+			context.abortSignal?.throwIfAborted();
+			return value;
+		},
+		read: async (conversationId: ConversationId, id: EntryId, range: EntryArchiveRange, context: Context) => {
+			context.abortSignal?.throwIfAborted();
+			if (
+				!range ||
+				Object.keys(range).sort().join(",") !== "commitSeq,length,offset" ||
+				!Number.isSafeInteger(range.offset) ||
+				range.offset < 0 ||
+				!Number.isSafeInteger(range.length) ||
+				range.length < 1 ||
+				range.length > 65536 ||
+				!Number.isSafeInteger(range.commitSeq) ||
+				range.commitSeq < 1
+			)
+				throw new StorageRequestError("Invalid bounded entry archive range");
+			const header = await this.readArchiveHeader(conversationId, id);
+			if (!header) return undefined;
+			if (header.commitSeq !== range.commitSeq || range.offset > header.byteLength)
+				throw new StorageRequestError("Stale entry archive revision or range");
+			const bytes = await this.readArchiveBytes(header, range);
+			if (bytes.length > range.length)
+				throw new StorageRequestError("Entry archive range exceeded its budget");
+			context.abortSignal?.throwIfAborted();
+			return {
+				bytes,
+				offset: range.offset,
+				nextOffset: range.offset + bytes.length,
+				byteLength: header.byteLength,
+				commitSeq: header.commitSeq,
+			};
+		},
+	});
+
+	private rememberArchiveHeader(scope: ConversationId, header: EntryHeader): EntryHeader {
+		const value = Object.freeze(header);
+		this.archiveHeaders.delete(header.id);
+		this.archiveHeaders.set(header.id, value);
+		const key = `${scope}/${header.id}`;
+		this.archiveScopes.delete(key);
+		this.archiveScopes.set(key, value);
+		while (this.archiveHeaders.size > ARCHIVE_HEADER_CACHE_LIMIT) {
+			const oldest = this.archiveHeaders.keys().next().value;
+			if (oldest === undefined) break;
+			this.archiveHeaders.delete(oldest);
+		}
+		while (this.archiveScopes.size > ARCHIVE_HEADER_CACHE_LIMIT) {
+			const oldest = this.archiveScopes.keys().next().value;
+			if (oldest === undefined) break;
+			this.archiveScopes.delete(oldest);
+		}
+		return value;
+	}
+
+	private async readArchiveHeader(scope: ConversationId, id: EntryId): Promise<EntryHeader | undefined> {
+		idFromNumber<ConversationId>(scope);
+		idFromNumber<EntryId>(id);
+		const key = `${scope}/${id}`;
+		const cached = this.archiveScopes.get(key);
+		if (cached) {
+			this.archiveScopes.delete(key);
+			this.archiveScopes.set(key, cached);
+			return cached;
+		}
+		return (await this.readEntryHeaders({ conversationId: scope, minEntryId: id, maxEntryId: id }, 1))
+			.items[0];
+	}
+
+	/** A byte-budgeted, encoding-only window; no EntryRecord or JSON body is decoded or retained. */
+	private async readArchiveBytes(header: EntryHeader, range: EntryArchiveRange): Promise<Uint8Array> {
+		const size = Math.min(range.length, header.byteLength - range.offset);
+		if (size === 0) return new Uint8Array();
+		if (header.byteLength > ARCHIVE_BYTE_CACHE_LIMIT) {
+			const row = await this.db.get<{ readonly bytes: Uint8Array }>(
+				`SELECT substr(CAST(record AS BLOB), ?, ?) AS bytes FROM ${this.schema.tables.entries} WHERE id = ? AND commit_seq = ?`,
+				range.offset + 1,
+				size,
+				header.id,
+				header.commitSeq,
+			);
+			if (!row) throw new StorageRequestError("Entry archive revision disappeared");
+			return new Uint8Array(row.bytes);
+		}
+		const cached = this.archiveBytes.get(header.id);
+		let bytes: Uint8Array;
+		if (cached && cached.commitSeq === header.commitSeq) {
+			this.archiveBytes.delete(header.id);
+			this.archiveBytes.set(header.id, cached);
+			bytes = cached.bytes;
+		} else {
+			let pending = this.pendingArchiveBytes.get(header.id);
+			if (!pending) {
+				// Coalesce concurrent reads of one immutable row; serialize complete-window acquisition.
+				pending = this.archiveByteLine.then(async () => {
+					const row = await this.db.get<{ readonly bytes: Uint8Array }>(
+						`SELECT CAST(record AS BLOB) AS bytes FROM ${this.schema.tables.entries} WHERE id = ? AND commit_seq = ?`,
+						header.id,
+						header.commitSeq,
+					);
+					if (!row || !(row.bytes instanceof Uint8Array) || row.bytes.length !== header.byteLength)
+						throw new StorageRequestError("Entry archive revision/encoded size changed");
+					while (
+						this.archiveByteCount + row.bytes.length > ARCHIVE_BYTE_CACHE_LIMIT &&
+						this.archiveBytes.size
+					) {
+						const oldest = this.archiveBytes.entries().next().value;
+						if (!oldest) break;
+						this.archiveBytes.delete(oldest[0]);
+						this.archiveByteCount -= oldest[1].bytes.length;
+					}
+					this.archiveBytes.set(header.id, { commitSeq: header.commitSeq, bytes: row.bytes });
+					this.archiveByteCount += row.bytes.length;
+					return row.bytes;
+				});
+				this.pendingArchiveBytes.set(header.id, pending);
+				this.archiveByteLine = pending.then(
+					() => {},
+					() => {},
+				);
+			}
+			try {
+				bytes = await pending;
+			} finally {
+				if (this.pendingArchiveBytes.get(header.id) === pending) this.pendingArchiveBytes.delete(header.id);
+			}
+		}
+		// Detach the published range. A caller can mutate it without changing the immutable cached source.
+		return new Uint8Array(bytes.subarray(range.offset, range.offset + size));
+	}
+
+	async conversation(id: ConversationId): Promise<ConversationRecord | undefined> {
+		const row = await this.db.get<JsonRow>(
+			`SELECT record FROM ${this.schema.tables.conversations} WHERE id = ?`,
+			id,
+		);
+		return row === undefined ? undefined : parseJson<ConversationRecord>(row.record);
+	}
+
+	async scanConversations(
+		query: ConversationQuery,
+		limit: number,
+		cursor: Cursor | undefined,
+	): Promise<Page<ConversationRecord, Cursor>> {
+		const start = scanStart(query.order, cursor, "ascending");
+		const scan = scanSql(start);
+		const clauses = [scan.clause];
+		const params: SqliteValue[] = [scan.param];
+		if (query.ownerConversationId !== undefined) {
+			clauses.push("owner_conversation_id = ?");
+			params.push(query.ownerConversationId);
+		}
+		if (query.ownerTaskId !== undefined) {
+			clauses.push("owner_task_id = ?");
+			params.push(query.ownerTaskId);
+		}
+		params.push(limit + 1);
+		const rows = await this.db.all<JsonRow>(
+			`SELECT record FROM ${this.schema.tables.conversations} WHERE ${clauses.join(" AND ")} ORDER BY id ${scan.direction} LIMIT ?`,
+			...params,
+		);
+		return page(
+			rows.map((row) => parseJson<ConversationRecord>(row.record)),
+			limit,
+			start.order,
+		);
+	}
+
+	async findDocument(address: DocumentAddress, at: DocumentPoint): Promise<DocumentRecord | undefined> {
+		const parts = addressParts(address);
+		const sql =
+			at === "current"
+				? `SELECT record FROM ${this.schema.tables.documents}
+					WHERE kind = ? AND scope_kind = ? AND owner_id = ? AND family = ? AND key_value = ?
+					AND retired_at IS NULL ORDER BY created_at DESC LIMIT 1`
+				: `SELECT record FROM ${this.schema.tables.documents}
+					WHERE kind = ? AND scope_kind = ? AND owner_id = ? AND family = ? AND key_value = ?
+					AND created_at <= ? AND (retired_at IS NULL OR retired_at > ?)
+					ORDER BY created_at DESC LIMIT 1`;
+		const params: SqliteValue[] = [parts.kind, parts.scopeKind, parts.ownerId, parts.family, parts.keyValue];
+		if (at !== "current") params.push(at, at);
+		const row = await this.db.get<JsonRow>(sql, ...params);
+		return row === undefined ? undefined : parseJson<DocumentRecord>(row.record);
+	}
+
+	/** Fork-aware metadata only: the SQL result never includes record/model/data JSON. */
+	private async readEntryHeaders(
+		query: EntryQuery,
+		limit: number,
+		cursor?: Cursor,
+	): Promise<Page<EntryHeader, Cursor>> {
+		if (!Number.isSafeInteger(limit) || limit < 1 || limit > 256)
+			throw new StorageRequestError("Invalid entry header page limit");
+		idFromNumber<ConversationId>(query.conversationId);
+		if (query.minEntryId !== undefined) idFromNumber<EntryId>(query.minEntryId);
+		if (query.maxEntryId !== undefined) idFromNumber<EntryId>(query.maxEntryId);
+		const { order, after } = scanStart(query.order, cursor, "descending");
+		let conversation = await this.conversation(query.conversationId);
+		if (!conversation) throw new StorageRequestError(`Unknown conversation: ${query.conversationId}`);
+		let upper: number | undefined = query.maxEntryId;
+		if (order === "descending" && after !== undefined)
+			upper = Math.min(upper ?? Number.MAX_SAFE_INTEGER, after - 1);
+		const segments: { readonly conversationId: ConversationId; readonly upper: number | undefined }[] = [];
+		const seen = new Set<ConversationId>();
+		while (true) {
+			if (seen.has(conversation.id)) throw new StorageRequestError("Cyclic conversation ancestry");
+			seen.add(conversation.id);
+			segments.push({ conversationId: conversation.id, upper });
+			if (!conversation.parent) break;
+			upper = Math.min(upper ?? Number.MAX_SAFE_INTEGER, conversation.parent.at);
+			if (query.minEntryId !== undefined && upper < query.minEntryId) break;
+			conversation = await this.conversation(conversation.parent.conversationId);
+			if (!conversation) throw new StorageRequestError("Missing conversation ancestry");
+		}
+		let lower: number | undefined = query.minEntryId;
+		if (order === "ascending" && after !== undefined) lower = Math.max(lower ?? 0, after + 1);
+		const values: EntryHeader[] = [];
+		for (const segment of order === "ascending" ? segments.reverse() : segments) {
+			const clauses = ["conversation_id = ?"];
+			const params: SqliteValue[] = [segment.conversationId];
+			if (lower !== undefined) {
+				clauses.push("id >= ?");
+				params.push(lower);
+			}
+			if (segment.upper !== undefined) {
+				clauses.push("id <= ?");
+				params.push(segment.upper);
+			}
+			params.push(limit + 1 - values.length);
+			const rows = await this.db.all<{
+				readonly id: number;
+				readonly conversation_id: number;
+				readonly head: number | null;
+				readonly commit_seq: number;
+			}>(
+				`SELECT id, conversation_id, head, commit_seq FROM ${this.schema.tables.entries} WHERE ${clauses.join(" AND ")} ORDER BY id ${order === "ascending" ? "ASC" : "DESC"} LIMIT ?`,
+				...params,
+			);
+			for (const row of rows) {
+				const id = idFromNumber<EntryId>(row.id),
+					commitSeq = seqFromNumber(row.commit_seq);
+				const cached = this.archiveHeaders.get(id);
+				let byteLength: number;
+				if (cached && cached.commitSeq === commitSeq) byteLength = cached.byteLength;
+				else {
+					const length = await this.db.get<{ readonly byte_length: number }>(
+						`SELECT length(CAST(record AS BLOB)) AS byte_length FROM ${this.schema.tables.entries} WHERE id = ? AND commit_seq = ?`,
+						id,
+						commitSeq,
+					);
+					if (!length || !Number.isSafeInteger(length.byte_length) || length.byte_length < 0)
+						throw new StorageRequestError("Invalid entry archive byte length");
+					byteLength = length.byte_length;
+				}
+				values.push(
+					this.rememberArchiveHeader(query.conversationId, {
+						id,
+						conversationId: idFromNumber<ConversationId>(row.conversation_id),
+						...(row.head === null ? {} : { head: idFromNumber<EntryId>(row.head) }),
+						commitSeq,
+						byteLength,
+					}),
+				);
+			}
+			if (values.length > limit) break;
+		}
+		return page(values, limit, order);
+	}
+
+	clear(): void {
+		this.archiveBytes.clear();
+		this.archiveByteCount = 0;
+		this.archiveHeaders.clear();
+		this.archiveScopes.clear();
+		this.pendingArchiveBytes.clear();
+	}
+}
+
+export async function materializeSqliteDocument(
+	executor: SqliteQueryExecutor,
+	schema: SqliteSchema,
+	id: DocumentId,
+	at: DocumentPoint,
+): Promise<StoredDocument | undefined> {
+	const row = await executor.get<JsonRow>(`SELECT record FROM ${schema.tables.documents} WHERE id = ?`, id);
+	if (row === undefined) return undefined;
+	const record = parseJson<DocumentRecord>(row.record);
+	if (at !== "current" && isCurrentOnly(record)) {
+		throw new StorageRequestError(`Document ${id} does not retain historical content`);
+	}
+	if (!isAliveAt(record, at)) return undefined;
+	const upper = at === "current" ? Number.MAX_SAFE_INTEGER : at;
+	const base = await executor.get<RevisionRow>(
+		`SELECT seq, kind, version, content FROM ${schema.tables.documentRevisions}
+			WHERE document_id = ? AND kind = 'base' AND seq <= ? ORDER BY seq DESC LIMIT 1`,
+		id,
+		upper,
+	);
+	if (base === undefined) throw new Error(`Document ${id} is missing a required base`);
+	let value = parseJson<JsonObject>(base.content);
+	const tail = await executor.all<RevisionRow>(
+		`SELECT seq, kind, version, content FROM ${schema.tables.documentRevisions}
+			WHERE document_id = ? AND seq > ? AND seq <= ? ORDER BY seq`,
+		id,
+		base.seq,
+		upper,
+	);
+	for (const revision of tail) {
+		if (revision.kind !== "delta" || revision.version !== base.version) {
+			throw new Error(`Document ${id} crosses a stored version boundary without a base`);
+		}
+		value = apply(value, parseJson<readonly Op[]>(revision.content)) as JsonObject;
+	}
+	return { record, version: base.version, value, deltasSinceBase: tail.length };
+}
diff --git a/packages/durable/src/storage/sqlite/reader.ts b/packages/durable/src/storage/sqlite/reader.ts
new file mode 100644
index 0000000..0f07c9e
--- /dev/null
+++ b/packages/durable/src/storage/sqlite/reader.ts
@@ -0,0 +1,155 @@
+import type { Context } from "@earendil-works/chord";
+import type { SqliteQueryExecutor, SqliteReadDatabase } from "#chord-sqlite/database";
+import { StorageRequestError } from "../../errors.ts";
+import { seqFromNumber } from "../../ids.ts";
+import type { EntryArchive, Seq, Storage } from "../../types.ts";
+import { CURRENT_SQLITE_SCHEMA_VERSION } from "./migrations.ts";
+import { materializeSqliteDocument, SqliteReadQueries } from "./read-queries.ts";
+import { createSqliteSchema, type SqliteSchema } from "./schema.ts";
+import type { SqliteStorageOptions } from "./storage.ts";
+
+export type SqliteReaderOptions = SqliteStorageOptions;
+
+/** A borrowed view of one committed database snapshot. It is invalid once its callback settles. */
+export interface SqliteReaderView {
+	/** Last committed sequence visible in this snapshot; zero denotes an empty storage. */
+	readonly sequence: Seq | 0;
+	readonly entryArchive: EntryArchive;
+	conversation: Storage["conversation"];
+	scanConversations: Storage["scanConversations"];
+	findDocument: Storage["findDocument"];
+	document: Storage["document"];
+}
+
+/** Existing native records only: no Session, task recovery, schema migration or write capability. */
+export interface SqliteReader {
+	/** Use only this callback's view and await its reads. Do not hold a snapshot across network/UI waits. */
+	snapshot<T>(read: (view: SqliteReaderView) => Promise<T>, context: Context): Promise<T>;
+	/** Reject new snapshots and release the connection after admitted callbacks settle. */
+	close(context: Context): Promise<void>;
+}
+
+/** The caller must select a compatible reader or explicitly migrate using the owning writer. */
+export class SqliteReaderVersionError extends Error {
