+/** Settings for an existing read-only file; WAL/checkpoint settings belong to its writer. */
+export type NodeSqliteReadDatabaseOptions = Pick<NodeSqliteDatabaseOptions, "busyTimeoutMs">;
+
+/** Open an existing regular file read-only, without changing journal settings or maintaining its WAL. */
+export async function openNodeSqliteReadDatabase(
+	path: string,
+	options: NodeSqliteReadDatabaseOptions = {},
+): Promise<SqliteReadDatabase> {
+	const file = resolve(path);
+	if (!(await stat(file)).isFile()) throw new Error("SQLite reader requires an existing regular file");
+	const database = new DatabaseSync(file, {
+		readOnly: true,
+		timeout: options.busyTimeoutMs ?? DEFAULT_BUSY_TIMEOUT_MS,
+	});
+	const statements = new Map<string, StatementSync>();
+	const access = new SerialOperationQueue();
+	const connectionScope = { active: true };
+	const connection = new NodeSqliteTransaction(database, statements, connectionScope);
+	let closing: Promise<void> | undefined;
+	const assertOpen = () => {
+		if (closing !== undefined) throw new Error("SQLite reader is closed");
+	};
+	// Only bound queries escape. In particular, do not return the executor's writable methods or raw connection.
+	return Object.freeze({
+		async get<T extends object>(sql: string, ...params: SqliteValue[]): Promise<T | undefined> {
+			assertOpen();
+			return access.runAsync(() => connection.get<T>(sql, ...params));
+		},
+		async all<T extends object>(sql: string, ...params: SqliteValue[]): Promise<T[]> {
+			assertOpen();
+			return access.runAsync(() => connection.all<T>(sql, ...params));
+		},
+		async transaction<T>(callback: (transaction: SqliteQueryExecutor) => Promise<T>): Promise<T> {
+			assertOpen();
+			return access.runAsync(async () => {
+				database.exec("BEGIN");
+				const scope = { active: true };
+				const transaction = new NodeSqliteTransaction(database, statements, scope);
+				try {
+					const result = await callback(
+						Object.freeze({
+							get: transaction.get.bind(transaction),
+							all: transaction.all.bind(transaction),
+						}),
+					);
+					scope.active = false;
+					database.exec("COMMIT");
+					return result;
+				} catch (error) {
+					scope.active = false;
+					try {
+						database.exec("ROLLBACK");
+					} catch (rollbackError) {
+						throw new AggregateError(
+							[error, rollbackError],
+							"SQLite read transaction failed and rollback failed",
+						);
+					}
+					throw error;
+				}
+			});
+		},
+		close(): Promise<void> {
+			if (closing === undefined) {
+				closing = access.run(() => {
+					connectionScope.active = false;
+					statements.clear();
+					database.close();
+				});
+			}
+			return closing;
+		},
+	});
+}
