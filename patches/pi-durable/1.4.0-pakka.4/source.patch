+					sequence,
+					conversation: (id, readContext) => run(readContext, () => queries.conversation(id)),
+					scanConversations: (query, limit, cursor, readContext) =>
+						run(readContext, () => {
+							if (!Number.isSafeInteger(limit) || limit < 1 || limit > 256)
+								throw new StorageRequestError("Invalid conversation page limit");
+							return queries.scanConversations(query, limit, cursor);
+						}),
+					findDocument: (address, at, readContext) =>
+						run(readContext, () => queries.findDocument(address, at)),
+					document: (id, at, readContext) =>
+						run(readContext, () => materializeSqliteDocument(transaction, schema, id, at)),
+					entryArchive: Object.freeze<EntryArchive>({
+						header: (conversationId, id, readContext) =>
+							run(readContext, () => queries.entryArchive.header(conversationId, id, readContext)),
+						scan: (query, limit, cursor, readContext) =>
+							run(readContext, () => queries.entryArchive.scan(query, limit, cursor, readContext)),
+						read: (conversationId, id, range, readContext) =>
+							run(readContext, () => queries.entryArchive.read(conversationId, id, range, readContext)),
+					}),
+				});
+				try {
+					const result = await read(view);
+					context.abortSignal?.throwIfAborted();
+					return result;
+				} finally {
+					active = false;
+					queries.clear();
+				}
+			});
+		},
+		close(_context: Context): Promise<void> {
+			closing ??= database.close();
+			return closing;
+		},
+	});
+}
