+	owner.exec("CREATE TABLE items (value INTEGER); INSERT INTO items VALUES (7)");
+	owner.close();
+	try {
+		assert.equal(typeof sqlite.openNodeSqliteReadDatabase, "function", "public read-only opener is required");
+		const reader = await sqlite.openNodeSqliteReadDatabase(file);
+		const entered = Promise.withResolvers<void>();
+		const release = Promise.withResolvers<void>();
+		const pending = reader.transaction(async (read) => {
