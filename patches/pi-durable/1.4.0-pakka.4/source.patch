+	const directory = await mkdtemp(join(tmpdir(), "chord-reader-wal-"));
+	const file = join(directory, "original.sqlite");
+	const owner = new DatabaseSync(file);
+	owner.exec(
+		"PRAGMA journal_mode=WAL; PRAGMA wal_autocheckpoint=0; CREATE TABLE items (id INTEGER PRIMARY KEY, value INTEGER); INSERT INTO items VALUES (1, 1), (2, 1)",
+	);
+	try {
+		assert.equal(typeof sqlite.openNodeSqliteReadDatabase, "function", "public read-only opener is required");
+		const reader = await sqlite.openNodeSqliteReadDatabase(file);
+		try {
+			const oldView = await reader.transaction(async (read) => {
+				assert.equal((await read.get<{ value: number }>("SELECT value FROM items WHERE id = 1"))?.value, 1);
+				owner.exec("BEGIN IMMEDIATE; UPDATE items SET value=2; COMMIT");
+				assert.equal((await read.get<{ value: number }>("SELECT value FROM items WHERE id = 2"))?.value, 1);
+				await assert.rejects(read.get("UPDATE items SET value=3 RETURNING value"));
+				return read;
+			});
+			await assert.rejects(oldView.get("SELECT value FROM items"));
+			assert.equal((await reader.get<{ value: number }>("SELECT value FROM items WHERE id = 1"))?.value, 2);
+			const before = await readFile(file);
