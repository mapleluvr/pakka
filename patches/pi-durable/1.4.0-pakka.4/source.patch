+++ b/packages/durable/test/pakka-sqlite-reader.test.ts
@@ -0,0 +1,259 @@
+import { strict as assert } from "node:assert";
+import { mkdtemp, readFile, rm, stat } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { DatabaseSync } from "node:sqlite";
+import { BACKGROUND_CONTEXT, withAbortSignal, withTelemetry } from "@earendil-works/chord/context";
+import type { ConversationId, DocumentId, EntryId, TaskId } from "@earendil-works/pi-durable";
+import * as sqlite from "@earendil-works/pi-durable/storage/sqlite/node";
+import { test } from "vitest";
+
+const context = BACKGROUND_CONTEXT;
+const parent = 2 as ConversationId,
+	original = 3 as EntryId,
+	late = 4 as EntryId;
+const child = 5 as ConversationId,
+	childEntry = 6 as EntryId,
+	peer = 7 as ConversationId;
+const peerEntry = 8 as EntryId,
+	documentId = 9 as DocumentId,
+	taskId = 10 as TaskId<null>;
+const body = '原文😀\\"\n'.repeat(80000) + "\ud800";
+const originalEntry = { id: original, conversationId: parent, kind: "reader.original", data: { text: body } };
+
+async function seed(file: string, prefix?: string) {
+	const storage = await sqlite.openNodeSqliteStorage(file, { prefix, walAutoCheckpointPages: 0 });
+	await storage.commit(
+		[
+			{ type: "conversation", value: { id: parent } },
+			{ type: "entry", value: originalEntry },
+			{ type: "entry", value: { id: late, conversationId: parent, kind: "reader.hidden" } },
+			{ type: "conversation", value: { id: child, parent: { conversationId: parent, at: original } } },
+			{ type: "entry", value: { id: childEntry, conversationId: child, kind: "reader.child" } },
+			{ type: "conversation", value: { id: peer } },
+			{ type: "entry", value: { id: peerEntry, conversationId: peer, kind: "reader.peer" } },
+			{
+				type: "document.create",
+				record: { id: documentId, kind: "reader.state", scope: { kind: "session" } },
+				content: { kind: "base", version: 7, value: { counter: 1 } },
+			},
+			{
+				type: "task",
+				value: {
+					id: taskId,
+					conversationId: parent,
+					kind: "reader.saved",
+					version: 1,
+					input: null,
+					background: false,
+					abortRequested: false,
+					restarts: 4,
+					state: { status: "running", checkpoint: { saved: true } },
+				},
+			},
+		],
+		context,
+	);
+	return storage;
+}
+
+// Reusing the writer opener, recovery, full-record decode, or a conversation_id-only scan breaks this test.
+test("installed reader preserves original forked bytes, saved documents and abandoned task state", async () => {
+	const directory = await mkdtemp(join(tmpdir(), "durable-reader-original-"));
+	const file = join(directory, "original.sqlite");
+	const storage = await seed(file, "history_");
+	await storage.close(context);
+	try {
+		assert.equal(typeof sqlite.openNodeSqliteReader, "function", "public history reader is required");
+		const before = await readFile(file);
+		const reader = await sqlite.openNodeSqliteReader(file, { prefix: "history_" });
+		try {
+			assert.equal("commit" in reader, false);
+			assert.equal("mintId" in reader, false);
+			assert.equal("db" in reader, false);
+			const expired = await reader.snapshot(async (read) => {
+				assert.equal("commit" in read, false);
+				assert.equal("get" in read, false);
+				assert.deepEqual((await read.conversation(child, context))?.parent, {
+					conversationId: parent,
+					at: original,
+				});
+				const first = await read.entryArchive.scan(
+					{ conversationId: child, order: "ascending" },
+					1,
+					undefined,
+					context,
+				);
+				assert.deepEqual(
+					first.items.map((entry) => entry.id),
+					[original],
+				);
+				const second = await read.entryArchive.scan(
+					{ conversationId: child, order: "ascending" },
+					1,
+					first.next,
+					context,
+				);
+				assert.deepEqual(
+					second.items.map((entry) => entry.id),
+					[childEntry],
+				);
+				assert.equal(await read.entryArchive.header(child, late, context), undefined);
+				assert.equal(await read.entryArchive.header(child, peerEntry, context), undefined);
+				const header = first.items[0]!;
+				assert.equal(header.conversationId, parent);
+				assert.equal("data" in header, false);
+				const chunks: Buffer[] = [];
+				for (let offset = 0; offset < header.byteLength; ) {
+					const chunk = await read.entryArchive.read(
+						child,
+						original,
+						{ offset, length: 65536, commitSeq: header.commitSeq },
+						context,
+					);
+					assert.ok(chunk && chunk.bytes.length > 0 && chunk.bytes.length <= 65536);
+					chunks.push(Buffer.from(chunk.bytes));
+					offset = chunk.nextOffset;
+				}
+				assert.equal(Buffer.concat(chunks).toString("utf8"), JSON.stringify(originalEntry));
+				await assert.rejects(
+					read.entryArchive.read(
+						child,
+						original,
+						{ offset: 0, length: 65537, commitSeq: header.commitSeq },
+						context,
+					),
+				);
+				const record = await read.findDocument(
+					{ kind: "reader.state", scope: { kind: "session" } },
+					"current",
+					context,
+				);
+				assert.equal(record?.id, documentId);
+				const document = await read.document(documentId, "current", context);
+				assert.equal(document?.version, 7);
+				assert.deepEqual(document?.value, { counter: 1 });
+				return read;
+			}, context);
+			await assert.rejects(expired.conversation(parent, context));
+			await assert.rejects(expired.entryArchive.header(child, original, context));
+		} finally {
+			await reader.close(context);
+		}
+		await assert.rejects(reader.snapshot(async () => undefined, context));
+		assert.deepEqual(await readFile(file), before);
+		const raw = new DatabaseSync(file, { readOnly: true });
+		try {
+			const saved = raw.prepare("SELECT record FROM history_tasks WHERE id = ?").get(taskId) as {
+				record: string;
+			};
+			assert.equal(JSON.parse(saved.record).state.status, "running");
+			assert.equal(JSON.parse(saved.record).restarts, 4);
+		} finally {
+			raw.close();
+		}
+	} finally {
+		await rm(directory, { recursive: true, force: true });
+	}
+});
+
+// A separate transaction per document query or a writer lock tears/blocks this actual two-connection trace.
+test("reader snapshots observe committed WAL without mixing a concurrent document replacement", async () => {
+	const directory = await mkdtemp(join(tmpdir(), "durable-reader-wal-"));
+	const file = join(directory, "original.sqlite");
+	const writer = await seed(file);
+	try {
+		assert.equal(typeof sqlite.openNodeSqliteReader, "function", "public history reader is required");
+		const reader = await sqlite.openNodeSqliteReader(file);
+		try {
+			await reader.snapshot(async (read) => {
+				assert.deepEqual((await read.document(documentId, "current", context))?.value, { counter: 1 });
+				await writer.commit(
+					[
+						{
+							type: "document.change",
+							id: documentId,
+							content: { kind: "base", version: 7, value: { counter: 2 } },
+						},
+					],
+					context,
+				);
+				assert.deepEqual((await read.document(documentId, "current", context))?.value, { counter: 1 });
+			}, context);
+			assert.deepEqual(
+				await reader.snapshot(
+					async (read) => (await read.document(documentId, "current", context))?.value,
+					context,
+				),
+				{ counter: 2 },
+			);
+			const wal = await readFile(`${file}-wal`);
+			await reader.close(context);
+			assert.deepEqual(await readFile(`${file}-wal`), wal);
+			assert.equal((await writer.task(taskId, context))?.state.status, "running");
+		} finally {
+			await reader.close(context);
+		}
+	} finally {
+		await writer.close(context);
+		await rm(directory, { recursive: true, force: true });
+	}
+});
+
+// Missing paths and schema mismatches must not be repaired by the observation path.
+test("reader rejects missing and incompatible sources without creating or migrating them", async () => {
+	const directory = await mkdtemp(join(tmpdir(), "durable-reader-schema-"));
+	try {
+		assert.equal(typeof sqlite.openNodeSqliteReader, "function", "public history reader is required");
+		await assert.rejects(sqlite.openNodeSqliteReader(join(directory, "missing", "new.sqlite")));
+		await assert.rejects(stat(join(directory, "missing")), { code: "ENOENT" });
+		for (const version of [1, 99]) {
+			const file = join(directory, `version-${version}.sqlite`);
+			const writer = await seed(file);
+			await writer.close(context);
+			const raw = new DatabaseSync(file);
+			raw.prepare("UPDATE durable_schema SET version = ?").run(version);
+			raw.close();
+			const before = await readFile(file);
+			await assert.rejects(sqlite.openNodeSqliteReader(file));
+			assert.deepEqual(await readFile(file), before);
+		}
+	} finally {
+		await rm(directory, { recursive: true, force: true });
+	}
+});
+
+// An aborted/expired view must not publish cached data or keep the file owned after close.
+test("reader respects cancellation and closes only after its admitted snapshot settles", async () => {
+	const directory = await mkdtemp(join(tmpdir(), "durable-reader-cancel-"));
+	const file = join(directory, "original.sqlite");
+	const writer = await seed(file);
+	await writer.close(context);
+	try {
+		assert.equal(typeof sqlite.openNodeSqliteReader, "function", "public history reader is required");
+		const reader = await sqlite.openNodeSqliteReader(file);
+		const abort = new AbortController();
+		const readContext = withTelemetry(context.telemetry, withAbortSignal(abort.signal, context));
+		const entered = Promise.withResolvers<void>();
+		const release = Promise.withResolvers<void>();
+		const pending = reader.snapshot(async (read) => {
+			await read.entryArchive.header(child, original, readContext);
+			entered.resolve();
+			await release.promise;
+			await assert.rejects(read.entryArchive.header(child, original, readContext));
+		}, readContext);
+		const rejected = assert.rejects(pending);
+		await entered.promise;
+		const closing = reader.close(context);
+		try {
+			await assert.rejects(reader.snapshot(async () => undefined, context));
+			abort.abort(new Error("cancelled read"));
+		} finally {
+			release.resolve();
+			await rejected;
+			await closing;
+		}
+	} finally {
+		await rm(directory, { recursive: true, force: true });
+	}
+});
