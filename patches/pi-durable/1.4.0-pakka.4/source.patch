+// A read-only type over a writable connection would fail the UPDATE ... RETURNING assertion.
+test("read database cannot write, create a missing source, or expose a writer", async () => {
+	const directory = await mkdtemp(join(tmpdir(), "chord-reader-"));
+	const file = join(directory, "original.sqlite");
+	const owner = new DatabaseSync(file);
+	owner.exec(
+		"CREATE TABLE items (id INTEGER PRIMARY KEY, value TEXT); INSERT INTO items VALUES (1, 'original')",
+	);
+	owner.close();
+	try {
+		assert.equal(typeof sqlite.openNodeSqliteReadDatabase, "function", "public read-only opener is required");
+		const before = await readFile(file);
+		const reader = await sqlite.openNodeSqliteReadDatabase(file);
+		try {
+			assert.equal(
+				(await reader.get<{ value: string }>("SELECT value FROM items WHERE id = 1"))?.value,
+				"original",
+			);
+			await assert.rejects(reader.get("UPDATE items SET value = 'changed' RETURNING value"));
+			assert.equal("exec" in reader, false);
+			assert.equal("run" in reader, false);
+			assert.equal("database" in reader, false);
+		} finally {
+			await reader.close();
+		}
+		await assert.rejects(reader.get("SELECT value FROM items"));
+		assert.deepEqual(await readFile(file), before);
+		await assert.rejects(sqlite.openNodeSqliteReadDatabase(join(directory, "missing", "source.sqlite")));
+		await assert.rejects(stat(join(directory, "missing")), { code: "ENOENT" });
+	} finally {
+		await rm(directory, { recursive: true, force: true });
+	}
+});
+
+// BEGIN IMMEDIATE, auto-checkpoint on close, or separate per-query snapshots each break this trace.
