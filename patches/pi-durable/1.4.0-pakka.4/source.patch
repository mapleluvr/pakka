+async function readSchema(
+	database: SqliteQueryExecutor,
+	schema: SqliteSchema,
+	checkStructure: boolean,
+): Promise<Seq | 0> {
+	const version = await database.get<{ version: number }>(
+		`SELECT version FROM ${schema.tables.durableSchema} WHERE singleton = 1`,
+	);
