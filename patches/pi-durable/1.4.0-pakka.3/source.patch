+import { createServer } from "node:http";
+import { createModels, createProvider, type Model } from "@earendil-works/pi-ai";
+import { openAICompletionsApi } from "@earendil-works/pi-ai/api/openai-completions.lazy";
+import { BACKGROUND_CONTEXT } from "@earendil-works/chord/context";
+import {
+	createRegistry,
+	defineExtension,
+	GenerationTask,
+	Harness,
+	hook,
+	type GenerationHooks,
+} from "@earendil-works/pi-durable";
+import { MemoryStorage } from "@earendil-works/pi-durable/storage/memory";
+import { describe, expect, test } from "vitest";
+
+const context = BACKGROUND_CONTEXT;
+
+/** Only an explicitly registered loopback provider; no environment credentials or model catalogs. */
+async function fixture(handlers: Partial<GenerationHooks>, beforePayload?: () => Promise<void>) {
+	const requests: { url: string | undefined; body: unknown }[] = [];
+	const failures: unknown[] = [];
+	const server = createServer(async (request, response) => {
+		try {
+			const chunks: Buffer[] = [];
+			for await (const chunk of request) chunks.push(Buffer.from(chunk));
+			requests.push({ url: request.url, body: JSON.parse(Buffer.concat(chunks).toString("utf8")) });
+			response.writeHead(200, { "content-type": "text/event-stream" });
+			for (const choice of [
+				{ index: 0, delta: { role: "assistant", content: "local answer" }, finish_reason: null },
+				{ index: 0, delta: {}, finish_reason: "stop" },
+			]) {
+				response.write(
+					`data: ${JSON.stringify({
+						id: "pakka-local",
+						object: "chat.completion.chunk",
+						created: 1,
+						model: "pakka-policy",
+						choices: [choice],
+					})}\n\n`,
+				);
+			}
+			response.end("data: [DONE]\n\n");
+		} catch (error) {
+			failures.push(error);
+			response.writeHead(500);
+			response.end("local fixture failed");
+		}
+	});
+	await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve));
+	const address = server.address();
+	if (address === null || typeof address === "string") throw new Error("Missing local server address");
+	const model: Model = {
+		id: "pakka-policy",
+		name: "Pakka local policy",
+		api: "openai-completions",
+		provider: "pakka-local",
+		baseUrl: `http://127.0.0.1:${address.port}/v1`,
+		reasoning: false,
+		input: ["text"],
+		cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+		contextWindow: 100_000,
+		maxTokens: 1024,
+	};
+	const api = openAICompletionsApi();
+	const models = createModels();
+	models.setProvider(
+		createProvider({
+			id: model.provider,
+			models: [model],
+			auth: { apiKey: { name: "local", resolve: async () => ({ auth: { apiKey: "local-only" } }) } },
+			api: {
+				stream: api.stream,
+				streamSimple: (requestModel, input, options) =>
+					api.streamSimple(requestModel, input, {
+						...options,
+						onPayload: async (payload, payloadModel) => {
+							await beforePayload?.();
+							return options?.onPayload?.(payload, payloadModel);
+						},
+					}),
+			},
+		}),
+	);
+	const registry = createRegistry();
+	registry.install(defineExtension({ name: "pakka-policy", hooks: [hook(GenerationTask, handlers)] }));
+	const reports: unknown[] = [];
+	let harness: Harness | undefined;
+	try {
+		harness = await Harness.open(
+			new MemoryStorage(),
+			{
+				models,
+				registry,
+				settings: { retry: { enabled: false }, compaction: { enabled: false } },
+				onReport: (error) => {
+					reports.push(error);
+				},
+			},
+			context,
+		);
+		const conversation = await harness.root(context, {
+			agent: { model: { provider: model.provider, modelId: model.id } },
+		});
+		return {
+			harness,
+			conversation,
+			requests,
+			reports,
+			failures,
+			close: async () => {
+				try {
+					await harness!.close(context);
+				} finally {
+					await new Promise<void>((resolve, reject) =>
+						server.close((error) => (error ? reject(error) : resolve())),
+					);
+				}
+			},
+		};
+	} catch (error) {
+		try {
+			await harness?.close(context);
+		} finally {
+			await new Promise<void>((resolve) => server.close(() => resolve()));
+		}
+		throw error;
+	}
+}
+
+describe("Pakka generation policy with real loopback HTTP", () => {
+	test("explicit block retains native receipts and idle; allowing a later input really reaches HTTP", async () => {
+		let allowed = false;
+		let decisions = 0;
+		const f = await fixture({
+			beforeRequest: () => {
+				decisions++;
+				return allowed ? undefined : { block: "policy denied" };
+			},
+		});
+		try {
+			const submission = { type: "input", content: "blocked input", requestId: "blocked-once" } as const;
+			const rejected = await f.conversation.submit(submission, context);
+			expect(await rejected.wait(context)).toMatchObject({
+				status: "unanswered",
+				reason: "blocked",
+				detail: "policy denied",
+			});
+			await f.conversation.waitForIdle(context);
+			expect(decisions).toBe(1);
+			expect(f.requests).toHaveLength(0);
+			expect(
+				(await f.conversation.context(context)).entries.filter((entry) => entry.kind === "pi.assistant"),
+			).toHaveLength(0);
+			const duplicate = await f.conversation.submit(submission, context);
+			expect(duplicate.id).toBe(rejected.id);
+			expect(await duplicate.wait(context)).toMatchObject({ status: "unanswered", reason: "blocked" });
+			expect(decisions).toBe(1);
+			allowed = true;
+			const accepted = await f.conversation.submit({ type: "input", content: "allowed input" }, context);
+			expect(await accepted.wait(context)).toMatchObject({ status: "done" });
+			await f.conversation.waitForIdle(context);
+			expect(decisions).toBe(2);
+			expect(f.requests).toHaveLength(1);
+			expect(f.requests[0].url).toBe("/v1/chat/completions");
+			expect(JSON.stringify(f.requests[0].body)).toContain("allowed input");
+			expect(f.reports).toEqual([]);
+			expect(f.failures).toEqual([]);
+		} finally {
+			await f.close();
+		}
+	});
+
+	test("revocation after an awaited provider payload transform blocks before HTTP", async () => {
+		let allowed = true;
+		let payloads = 0;
+		let checks = 0;
+		const f = await fixture(
+			{
+				beforeRequest: ({ messages }) => ({
+					messages,
+					check: () => {
+						checks++;
+						if (!allowed) throw new Error("revoked at payload");
+					},
+				}),
+			},
+			async () => {
+				await Promise.resolve();
+				payloads++;
+				allowed = false;
+			},
+		);
+		try {
+			const accepted = await f.conversation.submit({ type: "input", content: "revoked input" }, context);
+			expect(await accepted.wait(context)).toMatchObject({
+				status: "unanswered",
+				reason: "blocked",
+				detail: "revoked at payload",
+			});
+			await f.conversation.waitForIdle(context);
+			expect(checks).toBe(2);
+			expect(payloads).toBe(1);
+			expect(f.requests).toHaveLength(0);
+			expect(
+				(await f.conversation.context(context)).entries.filter((entry) => entry.kind === "pi.assistant"),
+			).toHaveLength(0);
+			expect(f.failures).toEqual([]);
+		} finally {
+			await f.close();
+		}
+	});
+
+	test("ordinary hook exceptions still report and continue to actual HTTP", async () => {
+		const failure = new Error("observer failed");
+		const f = await fixture({
+			beforeRequest: () => {
+				throw failure;
+			},
+		});
+		try {
+			const accepted = await f.conversation.submit({ type: "input", content: "ordinary hook throw" }, context);
+			expect(await accepted.wait(context)).toMatchObject({ status: "done" });
+			await f.conversation.waitForIdle(context);
+			expect(f.requests).toHaveLength(1);
+			expect(f.reports).toContain(failure);
+			expect(f.failures).toEqual([]);
+		} finally {
+			await f.close();
+		}
+	});
