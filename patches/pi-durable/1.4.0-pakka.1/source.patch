+describe("Pakka generation policy with real loopback HTTP", () => {
+	test("explicit block retains native receipts and idle; allowing a later input really reaches HTTP", async () => {
+		let allowed = false;
+		let decisions = 0;
+		const f = await fixture({
+			beforeRequest: () => {
+				decisions++;
+				return allowed ? undefined : { block: "policy denied" };
+			},
+		});
+		try {
+			const submission = { type: "input", content: "blocked input", requestId: "blocked-once" } as const;
+			const rejected = await f.conversation.submit(submission, context);
+			expect(await rejected.wait(context)).toMatchObject({
+				status: "unanswered",
+				reason: "blocked",
+				detail: "policy denied",
+			});
+			await f.conversation.waitForIdle(context);
+			expect(decisions).toBe(1);
+			expect(f.requests).toHaveLength(0);
+			expect(
+				(await f.conversation.context(context)).entries.filter((entry) => entry.kind === "pi.assistant"),
+			).toHaveLength(0);
+			const duplicate = await f.conversation.submit(submission, context);
+			expect(duplicate.id).toBe(rejected.id);
+			expect(await duplicate.wait(context)).toMatchObject({ status: "unanswered", reason: "blocked" });
+			expect(decisions).toBe(1);
+			allowed = true;
+			const accepted = await f.conversation.submit({ type: "input", content: "allowed input" }, context);
+			expect(await accepted.wait(context)).toMatchObject({ status: "done" });
+			await f.conversation.waitForIdle(context);
+			expect(decisions).toBe(2);
+			expect(f.requests).toHaveLength(1);
+			expect(f.requests[0].url).toBe("/v1/chat/completions");
+			expect(JSON.stringify(f.requests[0].body)).toContain("allowed input");
