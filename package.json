{
	"name": "pakka-workspace",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"workspaces": [
		"packages/protocol",
		"packages/agent",
		"packages/mas",
		"packages/mas-devpack",
		"packages/client",
		"apps/*"
	],
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"build": "npm run build --workspaces",
		"build:durable-patch": "node scripts/build-durable-patch.mjs",
		"check": "node scripts/verify-durable-patch.mjs && tsc --noEmit -p tsconfig.test.json",
		"test": "node scripts/test.mjs",
		"pack:agent": "npm run build && node scripts/pack-agent.mjs",
		"smoke:package": "npm run build && node scripts/pack-smoke.mjs",
		"test:dynamite": "node integrations/dynamite/run.mjs",
		"test:dynamite:product": "npm run build && node integrations/dynamite/product-run.mjs",
		"format:check": "prettier --check packages apps scripts integrations *.json"
	},
	"overrides": {
		"@earendil-works/chord": "1.0.3",
		"@earendil-works/pi-agent-core": "1.0.3",
		"@earendil-works/pi-ai": "1.0.3",
		"@earendil-works/pi-coding-agent": "1.0.3",
		"@earendil-works/pi-tui": "1.0.3",
		"@earendil-works/pi-mcp": "1.0.3",
		"@earendil-works/pi-codemode": "1.0.3",
		"@earendil-works/pi-telemetry": "1.0.3"
	},
	"dependencies": {
		"@earendil-works/pi-durable": "file:packages/agent/vendor/earendil-works-pi-durable-1.0.3-pakka.1.tgz"
	},
	"devDependencies": {
		"@types/node": "26.6.4",
		"prettier": "3.6.2",
		"typescript": "7.0.2"
	}
}
