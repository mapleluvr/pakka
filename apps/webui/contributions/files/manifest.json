					"path": {
						"type": "string",
						"maxLength": 512
					},
					"expectedSha256": {
						"anyOf": [
							{
								"type": "string",
								"maxLength": 64
							},
							{
								"type": "null"
							}
						]
					},
					"text": {
						"type": "string",
						"maxLength": 65536
					}
				},
				"required": ["root", "path", "expectedSha256", "text"]
