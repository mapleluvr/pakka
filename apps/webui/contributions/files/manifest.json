					"path": {
						"type": "string",
						"maxLength": 512
					}
				},
				"required": ["root", "path"]
			},
			"output": {
				"type": "object",
				"properties": {
					"root": {
						"type": "string",
						"maxLength": 160
					},
					"path": {
						"type": "string",
						"maxLength": 512
					},
					"entries": {
						"type": "array",
						"maxItems": 500,
						"items": {
							"type": "object",
							"properties": {
								"name": {
									"type": "string",
									"maxLength": 256
								},
								"path": {
									"type": "string",
									"maxLength": 512
								},
								"kind": {
									"enum": ["file", "directory"]
								},
								"bytes": {
									"type": "integer",
									"minimum": 0,
									"maximum": 9007199254740991
								}
							},
							"required": ["name", "path", "kind", "bytes"]
						}
					},
					"truncated": {
						"type": "boolean"
					}
				},
				"required": ["root", "path", "entries", "truncated"]
			}
		},
		{
			"id": "read",
			"version": 1,
			"scope": "conversation",
			"permission": "read",
			"effect": "read",
