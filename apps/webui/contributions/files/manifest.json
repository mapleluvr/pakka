			"id": "roots",
			"version": 1,
			"scope": "conversation",
			"permission": "read",
			"effect": "read",
			"timeoutMs": 15000,
			"input": {
				"type": "object",
				"properties": {},
				"required": []
			},
			"output": {
				"type": "object",
				"properties": {
					"roots": {
						"type": "array",
						"maxItems": 16,
						"items": {
							"type": "object",
							"properties": {
								"id": {
									"type": "string",
									"maxLength": 160
								},
								"writable": {
									"type": "boolean"
								},
								"git": {
									"type": "boolean"
								}
							},
							"required": ["id", "writable", "git"]
						}
					}
				},
				"required": ["roots"]
			}
		},
		{
			"id": "list",
			"version": 1,
			"scope": "conversation",
			"permission": "read",
			"effect": "read",
			"timeoutMs": 15000,
			"input": {
				"type": "object",
