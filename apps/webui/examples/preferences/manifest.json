{
	"api": 1,
	"id": "preferences",
	"version": "1.0.0",
	"title": "Example preferences",
	"facets": {
		"backend": "backend.mjs",
		"client": "client.js",
		"webui": {
			"entry": "index.js",
			"publicDir": "web"
		}
	},
	"actions": [
		{
			"id": "status",
			"version": 1,
			"scope": "app",
			"permission": "read",
			"effect": "read",
			"timeoutMs": 2000,
			"input": {
				"type": "object",
				"properties": {},
				"required": []
			},
			"output": {
				"type": "object",
				"properties": {
					"text": {
						"type": "string",
						"maxLength": 256
					}
				},
				"required": ["text"]
			}
		},
		{
			"id": "save",
			"version": 1,
			"scope": "app",
			"permission": "extensions.install",
			"effect": "write",
			"timeoutMs": 2000,
			"input": {
				"type": "object",
				"properties": {
					"text": {
						"type": "string",
						"maxLength": 256
					}
				},
				"required": ["text"]
			},
			"output": {
				"type": "object",
				"properties": {
					"text": {
						"type": "string",
						"maxLength": 256
					}
				},
				"required": ["text"]
			}
		},
		{
			"id": "card",
			"version": 1,
			"scope": "conversation",
			"permission": "send",
			"effect": "write",
			"timeoutMs": 2000,
			"input": {
				"type": "object",
				"properties": {
					"text": {
						"type": "string",
						"maxLength": 256
					}
				},
				"required": ["text"]
			},
			"output": {
				"type": "object",
				"properties": {
					"text": {
						"type": "string",
						"maxLength": 256
					}
				},
				"required": ["text"]
			}
		}
	],
	"commands": [
		{
			"id": "status",
			"title": "Read example preference",
			"slash": "preferences-status",
			"action": "status"
		},
		{
			"id": "card",
			"title": "Display a shared card",
			"slash": "preferences-card",
			"action": "card"
		}
	],
	"interfaces": [
		{
			"id": "settings",
			"title": "Example preferences",
			"slot": "settings",
			"scope": "app",
			"export": "Settings",
			"navigation": true
		},
		{
			"id": "panel",
			"title": "Example preference panel",
			"slot": "panel",
			"scope": "conversation",
			"export": "Settings",
			"navigation": false
		}
	]
}
