{
	"name": "@pakka/mas-devpack",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./agent": {
			"types": "./dist/profiles.d.ts",
			"import": "./dist/profiles.js"
		},
		"./workbench": {
			"types": "./dist/workbench.d.ts",
			"import": "./dist/workbench.js"
		},
		"./backend": {
			"types": "./dist/backend.d.ts",
			"import": "./dist/backend.js"
		},
		"./client": {
			"types": "./dist/browser/client.d.ts",
			"import": "./dist/browser/client.js"
		},
		"./webui": {
			"types": "./dist/browser/index.d.ts",
			"import": "./dist/browser/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"build:webui": "tsc -p tsconfig.webui.json && node scripts/write-manifest.mjs"
	},
	"peerDependencies": {
		"@pakka/agent": "0.7.0",
		"@pakka/mas": "0.4.0",
		"@pakka/webui": "0.1.0",
		"preact": "11.0.1"
	},
	"peerDependenciesMeta": {
		"@pakka/webui": {
			"optional": true
		},
		"preact": {
			"optional": true
		}
	}
}
