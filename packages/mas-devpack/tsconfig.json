{
	"compilerOptions": {
		"target": "ES2022",
		"types": ["node"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"skipLibCheck": true,
		"declaration": true,
		"rootDir": "src",
		"outDir": "dist",
		"rewriteRelativeImportExtensions": true
	},
	"include": ["src/index.ts", "src/ownership.ts", "src/workbench.ts", "src/profiles.ts"]
}
